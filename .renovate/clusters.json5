{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Separate PRs for main cluster",
      matchFileNames: [
        "**/kubernetes/apps/main/**",
        "**/kubernetes/clusters/main/**",
        "**/talos/main/**"
      ],
      additionalBranchPrefix: "main-",
      commitMessageSuffix: " [main]"
    },
    {
      description: "Separate PRs for network cluster",
      matchFileNames: [
        "**/kubernetes/apps/network/**",
        "**/kubernetes/cluster/network/**",
        "**/talos/network/**"
      ],
      additionalBranchPrefix: "network-",
      commitMessageSuffix: " [network]"
    },
    {
      description: "Separate PRs for registry cluster",
      matchFileNames: [
        "**/kubernetes/apps/registry/**",
        "**/kubernetes/clusters/registry/**",
        "**/talos/registry/**"
      ],
      additionalBranchPrefix: "registry-",
      commitMessageSuffix: " [registry]"
    },
    {
      description: "Separate PRs for test cluster",
      matchFileNames: [
        "**/kubernetes/apps/test/**",
        "**/kubernetes/clusters/test/**",
        "**/talos/test/**"
      ],
      additionalBranchPrefix: "test-",
      commitMessageSuffix: " [test]"
    },
    {
      description: "Separate PRs for Base",
      matchFileNames: [
        "**/kubernetes/apps/base/**",
      ],
      additionalBranchPrefix: "base-",
      commitMessageSuffix: " [base]"
    },
  ]
}
